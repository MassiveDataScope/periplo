# SPDX-License-Identifier: Apache-2.0
# Copy to .env and adjust. Compose reads it; the API reads the PERIPLO_* and AWS_* it passes on.
# Host port of the console and its API (both on one port, bound to localhost).
PERIPLO_PORT=8080
# Local tag of the image Compose builds, or a published one to run instead.
PERIPLO_IMAGE=periplo:dev

# The sources file mounted into the API (config/*.local.yaml stays out of git).
PERIPLO_SOURCES_FILE=./config/sources.example.yaml

# Logging: `prod` renders JSON, anything else a coloured console.
PERIPLO_ENV=prod
PERIPLO_LOG_LEVEL=INFO

# Query limits, all enforced by the API (apps/api/src/periplo/settings.py).
PERIPLO_MAX_CONCURRENT_QUERIES=2
PERIPLO_QUERY_TIMEOUT_SECONDS=60
PERIPLO_MAX_RESULT_ROWS=100000
PERIPLO_MAX_RESULT_BYTES=67108864
# Folders a discovery may list per source before the result is reported as partial.
PERIPLO_DISCOVERY_FOLDER_BUDGET=20000
# Table metadata cache: freshness window (0 probes storage on every access), byte budget of the
# derived cache, and how many open Delta snapshots are kept in memory.
PERIPLO_METADATA_TTL_SECONDS=30
PERIPLO_METADATA_CACHE_BYTES=33554432
PERIPLO_METADATA_SNAPSHOTS=64

# ETL orchestrator (Prefect). Worked examples with fake values: .env.etl.example.
# Unset API_URL keeps the integration off. Cloud: API_URL like
# https://api.prefect.cloud/api/accounts/<a>/workspaces/<w> plus API_KEY; self-hosted: http://host:4200/api
# plus AUTH_STRING (user:password) when the server has basic auth. TAGS (csv) filter every query.
# PERIPLO_PREFECT_API_URL=
# PERIPLO_PREFECT_API_KEY=
# PERIPLO_PREFECT_AUTH_STRING=
# PERIPLO_PREFECT_UI_URL=
# PERIPLO_PREFECT_TAGS=
# WARNING: with ALLOW_OPERATE on, anyone who can reach the pod can run, resume or pause ETLs,
# because the console has no authentication yet.
# PERIPLO_ETL_ALLOW_OPERATE=false
# PERIPLO_PREFECT_TIMEOUT_SECONDS=10
# Log line prefixes (csv) folded as noise in the log window; empty folds nothing.
# PERIPLO_ETL_LOG_NOISE=

# Existing AWS S3 storage. Set the region and the catalog to your account.
AWS_REGION=us-east-1
# Keep these temporary credentials private: never share them or commit them to git.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Pending: nothing reads these yet. Each needs a product decision before it is wired.
# PERIPLO_QUERY_MEMORY_BYTES=536870912   # per-query memory cap for the engine
# PERIPLO_CORS_ORIGINS=http://localhost:3000   # only needed if web and API are served from different origins
# PERIPLO_S3_ENDPOINT= / PERIPLO_S3_ALLOW_HTTP= / PERIPLO_S3_FORCE_PATH_STYLE=   # S3-compatible stores (MinIO)

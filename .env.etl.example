# SPDX-License-Identifier: Apache-2.0
# ETL console: the variables it needs, with FAKE values. Nothing here is a real endpoint or secret.
#
# Use it with Compose alongside your .env:
#   cp .env.etl.example .env.etl    # then replace the fake values (.env.etl stays out of git)
#   docker compose --env-file .env --env-file .env.etl up -d
# or append the block you need to .env (docker-compose.dev.yml / `make dev-real` only read .env).
#
# Unset PERIPLO_PREFECT_API_URL and the ETL section reports "not configured"; nothing else changes.

# ── Option A: self-hosted Prefect server (on the host, or reached through a tunnel on the host) ──
# From inside the api container the host is host.docker.internal (mapped in docker-compose.yml).
PERIPLO_PREFECT_API_URL=http://host.docker.internal:4200/api
# Basic auth of the server, "user:password"; leave empty if the server has none.
PERIPLO_PREFECT_AUTH_STRING=periplo:fake-password-change-me
# Where the browser opens "Open in orchestrator"; must be reachable from the user's browser, not the container.
PERIPLO_PREFECT_UI_URL=http://localhost:4200

# ── Option B: Prefect Cloud (comment Option A out and use these instead) ──
# PERIPLO_PREFECT_API_URL=https://api.prefect.cloud/api/accounts/00000000-0000-0000-0000-000000000000/workspaces/00000000-0000-0000-0000-000000000000
# The API key wins over AUTH_STRING when both are set.
# PERIPLO_PREFECT_API_KEY=pnu_FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE
# PERIPLO_PREFECT_UI_URL=https://app.prefect.cloud/account/00000000-0000-0000-0000-000000000000/workspace/00000000-0000-0000-0000-000000000000

# ── Common ──
# Only deployments carrying ALL these tags (csv) are shown: the boundary between tenants/lakes.
PERIPLO_PREFECT_TAGS=periplo,example-lake
# Limit of each call to the orchestrator, in seconds.
PERIPLO_PREFECT_TIMEOUT_SECONDS=10
# Run / resume / pause from the UI. Keep false: the console has no authentication yet,
# so with it on anyone who can reach the API can operate ETLs.
PERIPLO_ETL_ALLOW_OPERATE=false
# Log line prefixes folded as noise by default in the log window (csv); empty folds nothing.
# Example for loom-kernel pipelines on AWS ECS:
PERIPLO_ETL_LOG_NOISE=IntoHistory declared,IntoHistory has,Retrieving ECS,Using ECS,notifier raised
